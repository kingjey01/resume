"""
Résolution des fenêtres de période pour les statistiques.

Toutes les bornes sont calculées dans le timezone configuré de Django
(Africa/Kinshasa).

Les fenêtres sont des demi-ouvertes [start, end) :
start inclus, end exclus.

Pour 'custom', end est inclusif
(23:59:59.999999 de la date de fin).
"""

from datetime import datetime, timedelta

from django.utils import timezone


PERIOD_CHOICES = {
    'today': "Aujourd'hui",
    'last_7_days': '7 derniers jours',
    'last_30_days': '30 derniers jours',
    'this_week': 'Cette semaine',
    'this_month': 'Ce mois',
    'last_month': 'Mois précédent',
    'custom': 'Période personnalisée',
}


def _ensure_aware(dt):
    """
    Garantit qu'un datetime est timezone-aware.

    - datetime aware → retourné tel quel
    - datetime naive → interprété dans le timezone Django
    - None → None
    """
    if dt is None:
        return None

    if timezone.is_naive(dt):
        return timezone.make_aware(
            dt,
            timezone.get_default_timezone()
        )

    return dt


def local_now():
    """Retourne maintenant dans le timezone Django configuré."""
    return timezone.localtime(timezone.now())


def _start_of_day(dt):
    dt = _ensure_aware(dt)
    return dt.replace(
        hour=0,
        minute=0,
        second=0,
        microsecond=0
    )


def _start_of_week(dt):
    """
    Lundi de la semaine du datetime donné.
    """
    dt = _ensure_aware(dt)
    return _start_of_day(dt) - timedelta(days=dt.weekday())


def _start_of_month(dt):
    dt = _ensure_aware(dt)
    return dt.replace(
        day=1,
        hour=0,
        minute=0,
        second=0,
        microsecond=0
    )


def fixed_windows():
    """
    Fenêtres fixes :
    aujourd'hui, cette semaine, ce mois.
    """
    now = local_now()

    today_start = _start_of_day(now)
    week_start = _start_of_week(now)
    month_start = _start_of_month(now)

    return {
        'today': (
            today_start,
            today_start + timedelta(days=1)
        ),
        'this_week': (
            week_start,
            week_start + timedelta(days=7)
        ),
        'this_month': (
            month_start,
            _start_of_month(now + timedelta(days=32))
        ),
    }


def _month_bounds(month_start):
    """
    [1er du mois, 1er du mois suivant)
    """
    month_start = _ensure_aware(month_start)

    return (
        month_start,
        _start_of_month(month_start + timedelta(days=32))
    )


def resolve_period(
    period_key='last_30_days',
    start_date=None,
    end_date=None
):
    """
    Résout une période en bornes datetime aware.

    Retourne :
      key
      label
      start
      end
      previous_start
      previous_end
    """

    now = local_now()

    if period_key == 'today':

        start = _start_of_day(now)
        end = start + timedelta(days=1)

    elif period_key == 'last_7_days':

        start = _start_of_day(now) - timedelta(days=6)
        end = _start_of_day(now) + timedelta(days=1)

    elif period_key == 'last_30_days':

        start = _start_of_day(now) - timedelta(days=29)
        end = _start_of_day(now) + timedelta(days=1)

    elif period_key == 'this_week':

        start = _start_of_week(now)
        end = start + timedelta(days=7)

    elif period_key == 'this_month':

        start = _start_of_month(now)
        end = _start_of_month(now + timedelta(days=32))

    elif period_key == 'last_month':

        start = _start_of_month(
            _start_of_month(now) - timedelta(days=1)
        )

        end, _ = _month_bounds(start)

    elif period_key == 'custom':

        start = _parse_custom_date(
            start_date,
            default=_start_of_day(now)
        )

        end_raw = _parse_custom_date(
            end_date,
            default=start
        )

        end = end_raw.replace(
            hour=23,
            minute=59,
            second=59,
            microsecond=999999
        )

        previous_start = None
        previous_end = None

    else:
        raise ValueError(
            f"Période inconnue: {period_key}"
        )

    if period_key != 'custom':

        span = end - start

        previous_start = start - span
        previous_end = start

    else:

        previous_start = None
        previous_end = None

    return {
        'key': period_key,
        'label': PERIOD_CHOICES.get(
            period_key,
            period_key
        ),
        'start': _ensure_aware(start),
        'end': _ensure_aware(end),
        'previous_start': _ensure_aware(previous_start),
        'previous_end': _ensure_aware(previous_end),
    }


def _parse_custom_date(value, default):
    """
    Parse YYYY-MM-DD en datetime aware
    dans le timezone Django.
    """

    if not value:
        return _ensure_aware(default)

    try:

        dt = datetime.strptime(
            str(value),
            '%Y-%m-%d'
        )

        return timezone.make_aware(
            dt,
            timezone.get_default_timezone()
        )

    except (ValueError, TypeError):

        return _ensure_aware(default)


def iso(dt):
    """
    Format ISO 8601 avec offset.
    """
    dt = _ensure_aware(dt)

    return dt.isoformat() if dt else None


def _localize(dt):
    """
    Normalise un datetime éventuellement naive
    vers le timezone Django.
    """
    return _ensure_aware(dt)


def day_key(dt):
    """
    Clé YYYY-MM-DD en timezone local.
    """
    dt = _ensure_aware(dt)

    if dt is None:
        return None

    return timezone.localtime(dt).strftime(
        '%Y-%m-%d'
    )


def week_key(dt):
    """
    Clé YYYY-MM-DD correspondant au lundi
    de la semaine en timezone local.
    """
    dt = _ensure_aware(dt)

    if dt is None:
        return None

    local_dt = timezone.localtime(dt)

    return _start_of_week(local_dt).strftime(
        '%Y-%m-%d'
    )


def month_key(dt):
    """
    Clé YYYY-MM en timezone local.
    """
    dt = _ensure_aware(dt)

    if dt is None:
        return None

    return timezone.localtime(dt).strftime(
        '%Y-%m'
    )
