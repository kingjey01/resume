# Configuration Firebase Web — PWA Muhtasari+
#
# Copier ce fichier en `.env.pwa` (ignoré par Git) et renseigner les valeurs
# depuis la console Firebase : Paramètres du projet → Vos applications → Web.
# Puis générer le fichier utilisé par la PWA :
#
#   dart run tool/generate_firebase_config.dart
#
# Ne JAMAIS commiter `.env.pwa` ni `web/firebase-config.js`.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=resumeplus-2d47f.firebaseapp.com
FIREBASE_PROJECT_ID=resumeplus-2d47f
FIREBASE_STORAGE_BUCKET=resumeplus-2d47f.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=359361018508
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Cloud Messaging → Certificats push Web → clé VAPID (publique)
FIREBASE_VAPID_KEY=
